# Template for local environment configuration.
# Copy to .env and edit:  copy .env.example .env   (PowerShell: Copy-Item)

# ---------------------------------------------------------------------------
# Database engine
# ---------------------------------------------------------------------------
# Comment out the one you do NOT want and uncomment the one you do.

# Option 1: SQLite - file-based, no server needed
DB_ENGINE=sqlite

# Option 2: MySQL / MariaDB - local XAMPP server
# DB_ENGINE=mysql

# ---------------------------------------------------------------------------
# MySQL settings (only read when DB_ENGINE=mysql)
# ---------------------------------------------------------------------------
MYSQL_DATABASE=competition_hub
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=django-insecure-local-development-only
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# ---------------------------------------------------------------------------
# Semaphore SMS - https://semaphore.co/docs
# ---------------------------------------------------------------------------
# Copy the API key from https://semaphore.co/account and use an approved
# sender name. Leave the key blank to keep SMS disabled.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
SEMAPHORE_ENABLED=True
# Log messages without spending credits (useful for demos/testing).
SEMAPHORE_DRY_RUN=False
# Also text every active player on a team roster (default: managers/coaches only).
SEMAPHORE_NOTIFY_TEAM_PLAYERS=False
# Match times in SMS are shown in this time zone.
SEMAPHORE_TIMEZONE=Asia/Manila