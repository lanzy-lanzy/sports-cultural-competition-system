# Template for local environment configuration.
# Copy to .env and edit:  copy .env.example .env   (PowerShell: Copy-Item)

# ---------------------------------------------------------------------------
# Database engine
# ---------------------------------------------------------------------------
# Comment out the one you do NOT want and uncomment the one you do.

# Option 1: SQLite - file-based, no server needed
DB_ENGINE=sqlite

# Option 2: MySQL / MariaDB - local XAMPP server
# DB_ENGINE=mysql

# ---------------------------------------------------------------------------
# MySQL settings (only read when DB_ENGINE=mysql)
# ---------------------------------------------------------------------------
MYSQL_DATABASE=competition_hub
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=django-insecure-local-development-only
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*